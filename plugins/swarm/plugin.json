{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "swarm",
  "version": "0.1.0",
  "description": "Set up Zedbee Swarm, scan proposed JavaScript and TypeScript changes, repair authorized findings, and diagnose incomplete checks.",
  "author": {
    "name": "Zedbee",
    "url": "https://zedbee.dev"
  },
  "homepage": "https://zedbee.dev",
  "repository": "https://github.com/zbiles/zedbee",
  "license": "PolyForm-Small-Business-1.0.0",
  "keywords": ["swarm", "zedbee", "code-review", "javascript", "typescript"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Swarm",
        "shortDescription": "Scan, repair, verify changes",
        "longDescription": "Use Zedbee Swarm to set up repository checks, inspect complete findings, repair authorized changes, verify the updated proposal, and diagnose incomplete analysis.",
        "developerName": "Zedbee",
        "category": "Developer Tools",
        "websiteURL": "https://zedbee.dev",
        "privacyPolicyURL": "https://github.com/zbiles/zedbee/blob/main/docs/privacy.md",
        "termsOfServiceURL": "https://github.com/zbiles/zedbee/blob/main/LICENSE",
        "defaultPrompt": [
          "Set up Swarm in this repository.",
          "Scan my proposed changes with Swarm.",
          "Fix the authorized Swarm findings and verify the result."
        ],
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg",
        "supportURL": "https://github.com/zbiles/zedbee/issues"
      },
      "onboardingSkill": "./skills/setup/SKILL.md"
    }
  }
}
