{
  "name": "zedbee",
  "version": "0.1.0",
  "description": "Diff-aware pre-commit scanning for JavaScript and TypeScript",
  "type": "module",
  "bin": {
    "zedbee": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/zbiles/Zedbee.git"
  },
  "homepage": "https://github.com/zbiles/Zedbee#readme",
  "bugs": {
    "url": "https://github.com/zbiles/Zedbee/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/checks.md",
    "docs/commercial-licensing.md",
    "docs/dependency-license-obligations.md",
    "docs/managed-fixes.md",
    "docs/privacy.md",
    "docs/react-analysis.md",
    "docs/readability-complexity.md",
    "docs/reporting.md",
    "docs/structural-security-coverage.md",
    "docs/support.md",
    "schema",
    "licenses/production-inventory.json",
    "licenses/reviewed-overrides.json",
    "licenses/reviewed-obligations.json",
    "licenses/overrides"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "benchmark": "npm run build && node --experimental-strip-types bench/run.mts",
    "benchmark:update": "npm run build && node --experimental-strip-types bench/run.mts --update",
    "build": "node scripts/clean-build-output.mjs && tsc -p tsconfig.build.json && node scripts/finalize-build-output.mjs",
    "licenses:generate": "node scripts/generate-production-licenses.mjs",
    "licenses:check": "node scripts/check-production-licenses.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "artifact:prepare": "npm run package:check && node scripts/run-with-deadline.mjs scripts/prepare-release-artifact.mjs",
    "package:check": "npm run build && node scripts/check-package-contents.mjs",
    "prepack": "npm run build && npm run licenses:check",
    "schema:generate": "npm run build && node dist/config/json-schema.js --write",
    "schema:check": "npm run build && node dist/config/json-schema.js --check",
    "verify": "node scripts/run-with-deadline.mjs scripts/release-check.mjs --verify",
    "release:check": "node scripts/run-with-deadline.mjs scripts/release-check.mjs --release",
    "test": "npm run build && node scripts/run-with-deadline.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "npm run build && node scripts/run-with-deadline.mjs node_modules/vitest/vitest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "precommit",
    "static-analysis",
    "git",
    "typescript",
    "javascript",
    "ai-assisted-development"
  ],
  "license": "PolyForm-Small-Business-1.0.0",
  "dependencies": {
    "@ast-grep/napi": "0.45.1",
    "@eslint/js": "9.39.5",
    "@secretlint/core": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@secretlint/types": "13.0.5",
    "@yarnpkg/lockfile": "1.1.0",
    "commander": "15.0.0",
    "dependency-cruiser": "18.2.0",
    "diff": "9.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "execa": "10.0.1",
    "ink": "7.1.1",
    "jscpd": "5.0.15",
    "jsonc-parser": "3.3.1",
    "knip": "6.32.2",
    "p-limit": "7.3.1",
    "parse-diff": "0.12.0",
    "picomatch": "4.0.5",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "semver": "7.8.5",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.2.18",
    "@types/semver": "7.7.1",
    "ajv": "8.18.0",
    "ink-testing-library": "4.0.0",
    "spdx-expression-parse": "5.0.0",
    "tsx": "4.23.12",
    "vitest": "4.1.10"
  }
}
