{
  "name": "zedbee",
  "version": "0.1.0-beta.9",
  "description": "Diff-aware pre-commit scanning for JavaScript and TypeScript",
  "type": "module",
  "bin": {
    "zedbee": "./dist/cli.js"
  },
  "exports": {
    "./hooks": {
      "types": "./dist/hooks/install.d.ts",
      "import": "./dist/hooks/install.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/zbiles/zedbee.git"
  },
  "homepage": "https://zedbee.dev",
  "bugs": {
    "url": "https://github.com/zbiles/zedbee/issues"
  },
  "publishConfig": {
    "tag": "next",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "contentPolicy": {
    "class": "dual-use"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "DISCLOSURE",
    "THIRD_PARTY_NOTICES.md",
    "docs/checks.md",
    "docs/cli-reference.md",
    "docs/commercial-licensing.md",
    "docs/dependency-license-obligations.md",
    "docs/managed-fixes.md",
    "docs/privacy.md",
    "docs/react-analysis.md",
    "docs/readability-complexity.md",
    "docs/reporting.md",
    "docs/structural-security-coverage.md",
    "docs/support.md",
    "schema",
    "licenses/production-inventory.json",
    "licenses/reviewed-overrides.json",
    "licenses/reviewed-obligations.json",
    "licenses/overrides"
  ],
  "engines": {
    "node": "^22.17.0 || >=24.2.0"
  },
  "scripts": {
    "benchmark": "npm run build && node --experimental-strip-types bench/run.mts",
    "benchmark:update": "npm run build && node --experimental-strip-types bench/run.mts --update",
    "build": "node scripts/clean-build-output.mjs && node node_modules/typescript/bin/tsc -p tsconfig.build.json && node scripts/finalize-build-output.mjs",
    "licenses:generate": "node scripts/generate-production-licenses.mjs",
    "licenses:check": "node scripts/check-production-licenses.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "artifact:prepare": "npm run package:check && node scripts/run-with-deadline.mjs scripts/prepare-release-artifact.mjs",
    "package:check": "npm run build && node scripts/check-package-contents.mjs",
    "prepack": "npm run build && npm run licenses:check",
    "schema:generate": "npm run build && node dist/config/json-schema.js --write",
    "schema:check": "npm run build && node dist/config/json-schema.js --check",
    "verify": "node scripts/run-with-deadline.mjs scripts/release-check.mjs --verify",
    "release:check": "node scripts/run-with-deadline.mjs scripts/release-check.mjs --release",
    "test": "npm run build && node scripts/run-with-deadline.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "npm run build && node scripts/run-with-deadline.mjs node_modules/vitest/vitest.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "bundles:generate": "node scripts/generate-bundled-dependencies.mjs",
    "vendors:generate": "node scripts/generate-vendored-dependencies.mjs",
    "audit:production": "node scripts/audit-production-dependencies.mjs"
  },
  "keywords": [
    "precommit",
    "static-analysis",
    "git",
    "typescript",
    "javascript",
    "ai-assisted-development"
  ],
  "license": "PolyForm-Small-Business-1.0.0",
  "bundleDependencies": [
    "dependency-cruiser",
    "fdir",
    "formatly",
    "get-tsconfig",
    "ink",
    "jiti",
    "prettier",
    "react",
    "strip-json-comments",
    "typescript",
    "typescript-eslint",
    "unbash",
    "zod"
  ],
  "dependencies": {
    "@ast-grep/napi": "0.45.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.2",
    "@eslint/js": "9.39.5",
    "@napi-rs/wasm-runtime": "1.2.3",
    "@secretlint/core": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@secretlint/types": "13.0.5",
    "@tybys/wasm-util": "0.10.3",
    "@yarnpkg/lockfile": "1.1.0",
    "commander": "15.0.0",
    "dependency-cruiser": "18.2.0",
    "diff": "9.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "execa": "10.0.1",
    "fdir": "6.5.0",
    "formatly": "0.3.0",
    "get-tsconfig": "4.14.1",
    "husky": "9.1.7",
    "ignore": "7.0.6",
    "ink": "7.1.1",
    "jiti": "2.7.0",
    "jscpd": "5.3.2",
    "json5": "2.2.3",
    "jsonc-parser": "3.3.1",
    "koffi": "3.2.1",
    "oxc-parser": "0.143.0",
    "oxc-resolver": "11.24.2",
    "p-limit": "7.3.3",
    "parse-diff": "0.12.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "semver": "7.8.5",
    "smol-toml": "1.8.0",
    "strip-json-comments": "5.0.3",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "unbash": "4.0.10",
    "yaml": "2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/semver": "7.8.0",
    "ajv": "8.20.0",
    "ink-testing-library": "4.0.0",
    "knip": "6.32.2",
    "prettier-3-0-3": "npm:prettier@3.0.3",
    "react-19-2-0": "npm:react@19.2.0",
    "react-dom-19-2-0": "npm:react-dom@19.2.0",
    "spdx-expression-parse": "5.0.0",
    "tsx": "4.23.13",
    "typescript-5-9-3": "npm:typescript@5.9.3",
    "vitest": "5.0.1",
    "zod-4-1-12": "npm:zod@4.1.12"
  },
  "vendoredDependencies": {
    "knip": "6.32.2"
  }
}
